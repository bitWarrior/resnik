HELLO: PROGRAM;
  DECLARE DIVISOR INTEGER INITIAL(0);
  DECLARE RESULT SCALAR;

  ON ERROR(5):
  DO;
    WRITE(6) 'HELLO, TARGET [HAL/S LIVES!]';
    RESUME;
  END;

  MATH: PROCEDURE(INPUT_VAL);
    DECLARE INPUT_VAL SCALAR;
    RESULT = 100.0 / INPUT_VAL;   /* faults with no local handler */
  CLOSE MATH;

  CALL MATH(DIVISOR);
CLOSE HELLO;
