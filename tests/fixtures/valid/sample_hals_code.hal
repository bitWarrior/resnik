C Sample HAL/S Program for Testing Resnik Lexer
C This demonstrates various HAL/S language features

PROGRAM SAMPLE_FLIGHT_CONTROL;
   /* Block comment example
      Multi-line comment testing
   */
   
   DECLARE ALTITUDE SCALAR DOUBLE INITIAL(10000.0);
   DECLARE VELOCITY VECTOR(3) SINGLE;
   DECLARE POSITION_MATRIX MATRIX(3,3) DOUBLE;
   DECLARE STATUS_FLAG BIT(8) INITIAL(BIN '10101010');
   DECLARE HEX_VALUE BIT(16) INITIAL(HEX 'FF00');
   DECLARE MISSION_NAME CHARACTER(32) INITIAL('APOLLO_MISSION');
   DECLARE COUNTER INTEGER INITIAL(0);
   
   /* Vector and matrix operations */
   VELOCITY(1) = 500.25;
   VELOCITY(2) = 300.0E-2;
   VELOCITY(3) = -150.5E+3;
   
   /* Arithmetic operations */
   ALTITUDE = ALTITUDE + 100.0;
   COUNTER = COUNTER * 2;
   
   /* Conditional statement */
   IF ALTITUDE > 5000.0 THEN
      DO;
         COUNTER = COUNTER + 1;
      END;
   ELSE
      COUNTER = 0;
      
   /* Loop structure */
   DO FOR COUNTER = 1 TO 10 BY 2;
      ALTITUDE = ALTITUDE ** 2;
   END;
   
   /* Procedure call */
   CALL UPDATE_TELEMETRY(ALTITUDE, VELOCITY);
   
CLOSE SAMPLE_FLIGHT_CONTROL;

PROCEDURE UPDATE_TELEMETRY(ALT, VEL);
   DECLARE ALT SCALAR;
   DECLARE VEL VECTOR(3);
   
   /* Relational operators */
   IF ALT >= 10000.0 AND VEL(1) <= 1000.0 THEN
      DO;
         SEND SIGNAL;
      END;
      
   RETURN;
CLOSE UPDATE_TELEMETRY;
