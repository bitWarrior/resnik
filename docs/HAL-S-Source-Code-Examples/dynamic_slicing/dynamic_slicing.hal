DYNAMIC_SLICING: PROGRAM;
  DECLARE BIT_STREAM BIT(32) INITIAL(HEX '00FF00FF');
  DECLARE EXTRACTED BIT(8);
  DECLARE START_IDX INTEGER INITIAL(9);
  DECLARE SLICE_LEN INTEGER INITIAL(7); 

  DECLARE KILROY_TRAP BOOLEAN INITIAL(FALSE);

  /* SLICING BOUNDS DETERMINED BY RUNTIME EXPRESSIONS */
  EXTRACTED = BIT_STREAM$(START_IDX TO START_IDX + SLICE_LEN);

  IF EXTRACTED = HEX 'FF' THEN
  DO;
    WRITE(6) 'DYNAMIC SLICE EXTRACTION SUCCESSFUL';
  END;
  ELSE
  DO;
    KILROY_TRAP = TRUE;
    WRITE(6) 'KILROY ALERT: SLICE BOUNDARY MISMATCH';
  END;

CLOSE DYNAMIC_SLICING;
