CMD_DECODER: PROGRAM;
  DECLARE RAW_PACKET BIT(32) INITIAL(HEX 'DEADBEEF');
  DECLARE OPCODE BIT(8);
  DECLARE PAYLOAD INTEGER;
  DECLARE VALID_FLAG BOOLEAN;

  /* BIT SLICING A RANGE OF BITS */
  OPCODE = RAW_PACKET$(1 TO 8);

  /* TYPE COERCION: BIT STRING TO INTEGER */
  PAYLOAD = INTEGER(RAW_PACKET$(9 TO 32));

  /* BOOLEAN EVALUATION FROM BIT LOGIC */
  IF OPCODE = HEX 'DE' THEN
  DO;
    VALID_FLAG = TRUE;
  END;
  ELSE
  DO;
    VALID_FLAG = FALSE;
  END;

  IF VALID_FLAG THEN
  DO;
    WRITE(6) 'jstar COMMAND DECODED SUCCESSFULLY';
  END;

CLOSE CMD_DECODER;
