EULER: PROGRAM;
  
  /* SIMULATED INPUT PARAMETERS */
  DECLARE MASS_SOURCE SCALAR INITIAL(5.972E24); /* MASS OF EARTH */
  DECLARE DT SCALAR INITIAL(0.1);               /* TIMESTEP IN SECONDS */
  
  /* SIMULATED STATE VECTORS */
  DECLARE POS VECTOR(3) INITIAL(6771000.0, 0.0, 0.0);
  DECLARE VEL VECTOR(3) INITIAL(0.0, 7660.0, 0.0);

  /* LOCAL VARIABLES */
  DECLARE G_CONST CONSTANT SCALAR(6.67430E-11);
  DECLARE DIST SCALAR;
  DECLARE ACCEL_VEC VECTOR(3);

  /* KILROY SENTINEL FOR ZERO-DISTANCE SINGULARITY */
  DECLARE KILROY_FAULT BOOLEAN INITIAL(FALSE);

  /* 1. CALCULATE DISTANCE MAGNITUDE NATIVELY */
  DIST = ABVAL(POS);

  IF DIST > 0.0 THEN
  DO;
    /* 2 & 3. CALCULATE ACCELERATION VECTOR DIRECTLY 
       Mathematically: a = -(G * M / dist^3) * pos 
    */
    ACCEL_VEC = -(G_CONST * MASS_SOURCE / (DIST ** 3)) * POS;

    /* 4. UPDATE VELOCITY (EULER INTEGRATION) */
    VEL = VEL + (ACCEL_VEC * DT);

    /* 5. UPDATE POSITION */
    POS = POS + (VEL * DT);
    
    WRITE(6) 'PHYSICS STATE UPDATED';
  END;
  ELSE
  DO;
    KILROY_FAULT = TRUE;
    WRITE(6) 'PROPAGATOR FAULT: SINGULARITY DETECTED';
  END;

CLOSE EULER;
