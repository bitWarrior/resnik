DATA_PIPELINE: PROGRAM;
  /* AN ARRAY CONTAINING THREE 3D VECTORS */
  DECLARE SENSOR_BANK ARRAY(3) OF VECTOR(3);
  DECLARE I INTEGER;
  DECLARE FAULT BOOLEAN INITIAL(FALSE);

  /* SUBROUTINE DEFINITION (MUST PRECEDE CALL OR BE PROTOTYPED) */
  NORMALIZE_BANK: PROCEDURE ASSIGN(BANK_IN);
    DECLARE BANK_IN ARRAY(3) OF VECTOR(3);
    DECLARE IDX INTEGER;

    DO FOR IDX = 1 TO 3;
      IF ABVAL(BANK_IN$IDX) > 0.0 THEN
      DO;
        BANK_IN$IDX = UNIT(BANK_IN$IDX);
      END;
    END;
  CLOSE NORMALIZE_BANK;

  /* INITIALIZE THE ARRAY ELEMENTS */
  DO FOR I = 1 TO 3;
    SENSOR_BANK$I = VECTOR(1.0, 2.0, 3.0);
  END;

  /* PASS THE ARRAY BY REFERENCE */
  CALL NORMALIZE_BANK ASSIGN(SENSOR_BANK);

  /* VERIFY MODIFICATION */
  IF ABVAL(SENSOR_BANK$1) < 1.01 AND ABVAL(SENSOR_BANK$1) > 0.99 THEN
  DO;
    WRITE(6) 'ARRAY NORMALIZATION SUCCESSFUL';
  END;
  ELSE
  DO;
    FAULT = TRUE;
  END;

CLOSE DATA_PIPELINE;
