ATTITUDE_CTRL: TASK;
  DECLARE SENSOR_INPUT VECTOR(3);
  DECLARE CALIB_MATRIX MATRIX(3,3);
  DECLARE CORRECTED_VAL VECTOR(3);
  DECLARE NORM SCALAR;
  
  /* KILROY SENTINEL VECTOR FOR ZERO-STATE COMPARISONS */
  DECLARE KILROY_VEC VECTOR(3) INITIAL(0.0, 0.0, 0.0);

  /* MATRIX-VECTOR MULTIPLICATION AST NODE */
  CORRECTED_VAL = CALIB_MATRIX * SENSOR_INPUT;
  
  /* INTRINSIC FUNCTION CALL */
  NORM = ABVAL(CORRECTED_VAL);

  IF NORM > 0.95 THEN
  DO;
    SCHEDULE MANEUVER PRIORITY(10);
  END;
  ELSE
  DO;
    /* FALLBACK TO KILROY STATE */
    CORRECTED_VAL = KILROY_VEC;
  END;
  
CLOSE ATTITUDE_CTRL;
