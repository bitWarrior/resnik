TELEMETRY_APP: PROGRAM;

  /* DEFINE A STRUCTURE TEMPLATE */
  STRUCTURE NODE:
    DECLARE STATUS BIT(8);
    DECLARE POSITION VECTOR(3);
    DECLARE TIMESTAMP SCALAR;
  CLOSE NODE;

  /* INSTANTIATE STRUCTURE VARIABLES USING THE TEMPLATE */
  DECLARE PRIMARY_ALARM NODE STRUCTURE;
  DECLARE BACKUP_ALARM NODE STRUCTURE;

  /* INDIVIDUAL STRUCTURE TERMINAL ASSIGNMENT */
  PRIMARY_ALARM.TIMESTAMP = 1024.05;
  PRIMARY_ALARM.POSITION = VECTOR(0.0, 1.0, 0.0);
  PRIMARY_ALARM.STATUS = HEX 'FF';

  /* WHOLE-STRUCTURE AGGREGATE COPY */
  BACKUP_ALARM = PRIMARY_ALARM;

  IF BACKUP_ALARM.STATUS = PRIMARY_ALARM.STATUS THEN
  DO;
    WRITE(6) 'STRUCTURE INTEGRITY VERIFIED';
  END;

CLOSE TELEMETRY_APP;
