DANGLING_ELSE_TRAP: PROGRAM;
  DECLARE SENSOR_A INTEGER INITIAL(1);
  DECLARE SENSOR_B INTEGER INITIAL(0);
  DECLARE FLAG BOOLEAN INITIAL(TRUE);

  /* NESTED IF WITHOUT 'DO...END' BLOCKS */
  IF SENSOR_A = 1 THEN
    IF SENSOR_B = 1 THEN
      WRITE(6) 'BOTH SENSORS ACTIVE';
    ELSE
      FLAG = FALSE;
  ELSE
    WRITE(6) 'SENSOR A OFFLINE';

  IF FLAG = FALSE THEN
  DO;
    WRITE(6) 'DANGLING ELSE RESOLVED CORRECTLY';
  END;

CLOSE DANGLING_ELSE_TRAP;
