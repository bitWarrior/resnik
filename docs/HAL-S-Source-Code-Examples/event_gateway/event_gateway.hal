EVENT_GATEWAY: PROGRAM;
  DECLARE UPLINK_SYNC EVENT;
  DECLARE KILROY_READY EVENT;
  DECLARE SAFEHOLD_TIMEOUT EVENT;
  DECLARE PROCEED_FLAG BOOLEAN INITIAL(FALSE);

  /* TASK TO SIMULATE ASYNCHRONOUS TRIGGERS */
  TRIGGER_SIM: TASK;
    SIGNAL KILROY_READY;
    SIGNAL UPLINK_SYNC;
  CLOSE TRIGGER_SIM;

  SCHEDULE TRIGGER_SIM PRIORITY(20);

  /* OS DIRECTIVE WITH EMBEDDED BOOLEAN LOGIC */
  WAIT FOR (UPLINK_SYNC AND KILROY_READY) OR SAFEHOLD_TIMEOUT;

  /* IF WE PASS THE WAIT BLOCK, DETERMINE WHICH BRANCH OPENED THE GATE */
  IF SAFEHOLD_TIMEOUT THEN
  DO;
    WRITE(6) 'ABORT: TIMEOUT REACHED';
  END;
  ELSE
  DO;
    PROCEED_FLAG = TRUE;
    WRITE(6) 'SYNC ACHIEVED, ENGAGED';
  END;

CLOSE EVENT_GATEWAY;
