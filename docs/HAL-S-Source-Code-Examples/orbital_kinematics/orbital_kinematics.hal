ORBITAL_KINEMATICS: PROGRAM;
  /* UNIVERSAL CONSTANTS */
  DECLARE G_CONST CONSTANT SCALAR(6.6743E-11); 
  DECLARE MASS_EARTH CONSTANT SCALAR(5.972E24);
  
  /* CUBESAT STATE VECTORS */
  DECLARE MASS_SAT SCALAR INITIAL(12.5);
  DECLARE POS_EARTH VECTOR(3) INITIAL(0.0, 0.0, 0.0);
  DECLARE POS_SAT VECTOR(3) INITIAL(6771000.0, 0.0, 0.0);
  
  /* FLAG TO CATCH SINGULARITIES */
  DECLARE KILROY_CRASH BOOLEAN INITIAL(FALSE);

  /* INTERMEDIATE AND RESULT VECTORS */
  DECLARE R_VEC VECTOR(3);
  DECLARE R_MAG SCALAR;
  DECLARE FORCE_VEC VECTOR(3);
  DECLARE ACCEL_VEC VECTOR(3);

  /* COMPUTE DIRECTIONAL VECTOR FROM EARTH TO SATELLITE */
  R_VEC = POS_SAT - POS_EARTH;
  
  /* INTRINSIC MAGNITUDE RESOLUTION */
  R_MAG = ABVAL(R_VEC);

  IF R_MAG > 0.0 THEN
  DO;
    /* AST STRESS TEST: SCALAR MATH APPLIED TO A VECTOR
       The ** operator denotes exponentiation in HAL/S.
    */
    FORCE_VEC = ( -G_CONST * MASS_EARTH * MASS_SAT / (R_MAG ** 3) ) * R_VEC;
    
    /* VECTOR SCALING: DIVIDING A VECTOR BY A SCALAR */
    ACCEL_VEC = FORCE_VEC / MASS_SAT;
    
    WRITE(6) 'ACCELERATION VECTOR UPDATED IN jstar SIMULATOR';
  END;
  ELSE
  DO;
    /* HANDLE ZERO-DISTANCE SINGULARITY */
    ACCEL_VEC = VECTOR(0.0, 0.0, 0.0);
    KILROY_CRASH = TRUE;
    WRITE(6) 'COLLISION DECTECTED';
  END;

CLOSE ORBITAL_KINEMATICS;
