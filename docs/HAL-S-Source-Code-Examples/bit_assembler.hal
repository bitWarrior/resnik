BIT_ASSEMBLER: PROGRAM;
  DECLARE HIGH_BYTE BIT(8) INITIAL(HEX 'AA');
  DECLARE LOW_BYTE BIT(8) INITIAL(HEX '55');
  DECLARE WORD_VAL BIT(16);
  
  DECLARE SYNC BOOLEAN INITIAL(FALSE);

  /* BITWISE CONCATENATION */
  WORD_VAL = HIGH_BYTE || LOW_BYTE;

  IF WORD_VAL = HEX 'AA55' THEN
  DO;
    SYNC = TRUE;
    WRITE(6) 'VERIFIES BIT CONCATENATION AST NODE';
  END;

CLOSE BIT_ASSEMBLER;
