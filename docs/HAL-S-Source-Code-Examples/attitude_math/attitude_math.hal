ATTITUDE_MATH: PROGRAM;
  DECLARE V_TARGET VECTOR(3) INITIAL(1.0, 1.0, 0.0);
  DECLARE V_CURRENT VECTOR(3) INITIAL(1.0, 0.0, 0.0);
  
  DECLARE THETA_RAD SCALAR;
  DECLARE THETA_DEG SCALAR;
  DECLARE RAD_TO_DEG CONSTANT SCALAR(57.29578);

  /* CHAINED INTRINSICS: COMPOSING DOT, UNIT, AND ARCCOS */
  THETA_RAD = ARCCOS( DOT( UNIT(V_TARGET), UNIT(V_CURRENT) ) );

  /* SCALAR CONVERSION */
  THETA_DEG = THETA_RAD * RAD_TO_DEG;

  IF THETA_DEG > 0.0 THEN
  DO;
    WRITE(6) 'ANGLE COMPUTED CORRECTLY';
  END;

CLOSE ATTITUDE_MATH;
