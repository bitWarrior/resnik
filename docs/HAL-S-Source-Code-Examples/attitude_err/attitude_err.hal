ATTITUDE_ERR: PROGRAM;
  DECLARE V_SUN VECTOR(3) INITIAL(1.0, 0.0, 0.0);
  DECLARE V_MAG VECTOR(3) INITIAL(0.0, 1.0, 0.0);
  
  /* MULTIPLE VARIABLE DECLARATION ON ONE LINE */
  DECLARE V_TORQUE, V_ERROR VECTOR(3);

  /* NATIVE CROSS PRODUCT AND MULTIPLE ASSIGNMENT */
  V_TORQUE, V_ERROR = CROSS(V_SUN, V_MAG);

  IF ABVAL(V_ERROR) > 0.5 THEN
  DO;
     WRITE(6) 'TORQUE EXCEEDS THRESHOLD, DUMPING MOMENTUM';
  END;
CLOSE ATTITUDE_ERR;
