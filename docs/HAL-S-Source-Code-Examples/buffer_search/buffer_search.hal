BUFFER_SEARCH: PROGRAM;
  /* INITIALIZE A 10-ELEMENT HISTORY BUFFER */
  DECLARE HISTORY ARRAY(10) OF INTEGER INITIAL(10, 20, 30, 99, 50, 60, 70, 80, 90, 100);
  
  /* THE FAULT CODE WE ARE LOOKING FOR */
  DECLARE FAULT_TARGET CONSTANT INTEGER(99);
  
  DECLARE FOUND_IDX INTEGER INITIAL(0);
  DECLARE I INTEGER;

  DECLARE ESCAPED BOOLEAN INITIAL(FALSE);

  /* REVERSE ITERATION USING DOWNTO */
  DO FOR I = 10 DOWNTO 1;
    
    IF HISTORY$I = FAULT_TARGET THEN
    DO;
      /* RECORD THE INDEX WHERE THE FAULT OCCURRED */
      FOUND_IDX = I;
      
      /* IMMEDIATELY BREAK OUT OF THE ENCLOSING LOOP */
      EXIT;
    END;

  END;

  IF FOUND_IDX = 4 THEN
  DO;
    WRITE(6) 'FOUND THE FAULT AT INDEX 4, LOOP EXITED EARLY';
  END;
  ELSE
  DO;
    ESCAPED = TRUE;
  END;

CLOSE BUFFER_SEARCH;
