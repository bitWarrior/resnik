PRECISION_MATH: PROGRAM;
  /* EXPLICIT PRECISION DECLARATIONS */
  DECLARE SINGLE_VAL SCALAR SINGLE INITIAL(1.5);
  DECLARE DOUBLE_VAL SCALAR DOUBLE INITIAL(3.14159265359);
  
  /* TARGET FOR PROMOTED MATH */
  DECLARE RESULT_VAL SCALAR DOUBLE;
  DECLARE LOSS BOOLEAN INITIAL(FALSE);

  /* MIXED PRECISION MATH PROMOTES TO DOUBLE */
  RESULT_VAL = SINGLE_VAL * DOUBLE_VAL;

  IF RESULT_VAL > 4.71 THEN
     WRITE(6) 'PRECISION PROMOTION SUCCESSFUL';
  ELSE
     LOSS = TRUE;

CLOSE PRECISION_MATH;
