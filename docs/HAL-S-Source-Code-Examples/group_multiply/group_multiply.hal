GROUP_MULTIPLY: PROGRAM;

  DECLARE X SCALAR INITIAL(3.0);
  DECLARE PROD SCALAR;
  DECLARE DIFFSQ SCALAR;
  DECLARE ZERO INTEGER INITIAL(1);
  DECLARE TRAP INTEGER;
  DECLARE FAIL_FLAG BOOLEAN INITIAL(FALSE);

  /* 2.0 * (3.0 + 1.0) = 8.0  -- NUMBER then LPAREN */
  PROD = 2.0(X + 1.0);

  /* (3.0 + 1.0) * (3.0 - 1.0) = 8.0  -- RPAREN then LPAREN */
  DIFFSQ = (X + 1.0)(X - 1.0);

  WRITE(6) 'GROUP PRODUCTS:', PROD, DIFFSQ;
  IF PROD NOT = 8.0 THEN FAIL_FLAG = TRUE;
  IF DIFFSQ NOT = 8.0 THEN FAIL_FLAG = TRUE;

  IF FAIL_FLAG THEN
  DO;
    WRITE(6) 'GROUP MULTIPLY CHECK FAILED';
    ZERO = ZERO - 1;
    TRAP = 1 / ZERO;
  END;
  ELSE
    WRITE(6) 'GROUP MULTIPLY PASSED';

CLOSE GROUP_MULTIPLY;
