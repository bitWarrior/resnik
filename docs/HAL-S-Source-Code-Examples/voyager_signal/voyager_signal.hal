VOYAGER_SIGNAL: PROGRAM;
  
  /* UNIVERSAL CONSTANTS */
  DECLARE C_CONST CONSTANT SCALAR(299792.458); /* SPEED OF LIGHT IN KM/S */
  
  /* VOYAGER 1 CURRENT DISTANCE (MID-2026 IN KM) */
  DECLARE V1_DIST SCALAR INITIAL(2.5461E10);
  
  /* TARGET VARIABLES FOR TIME CALCULATION */
  DECLARE TIME_SEC SCALAR;
  DECLARE TIME_HRS SCALAR;
  
  /* FLAG TO CHECK FOR MATH BOUNDS */
  DECLARE TRAP BOOLEAN INITIAL(FALSE);

  /* AVOID DIVISION BY ZERO / NEGATIVE DISTANCE SINGULARITIES */
  IF V1_DIST > 0.0 THEN
  DO;
    /* SIGNAL ONE-WAY TRANSIT TIME IN SECONDS */
    TIME_SEC = V1_DIST / C_CONST;
    
    /* CONVERT TO HOURS */
    TIME_HRS = TIME_SEC / 3600.0;
    
    /* MIXED-TYPE WRITE STATEMENTS PRINTING THE RESULT */
    WRITE(6) 'TRANSIT TIME (SECONDS): ', TIME_SEC;
    WRITE(6) 'TRANSIT TIME (HOURS): ', TIME_HRS;
  END;
  ELSE
  DO;
    TRAP = TRUE;
    WRITE(6) 'ALERT: DISTANCE CANNOT BE ZERO OR NEGATIVE';
  END;

CLOSE VOYAGER_SIGNAL;
