GOTO_TOKEN: PROGRAM;

  DECLARE HIT BOOLEAN INITIAL(FALSE);
  DECLARE SKIPPED BOOLEAN INITIAL(FALSE);
  DECLARE ZERO INTEGER INITIAL(1);
  DECLARE TRAP INTEGER;
  DECLARE FAIL_FLAG BOOLEAN INITIAL(FALSE);

  /* Lower-case GOTO, mixed-case label. Dispatch is case-insensitive. */
  goto Done;

  SKIPPED = TRUE;
  WRITE(6) 'GOTO FAILED TO BRANCH';

DONE:
  HIT = TRUE;
  WRITE(6) 'ONE-TOKEN GOTO DISPATCHED';

  IF SKIPPED THEN FAIL_FLAG = TRUE;
  IF HIT NOT = TRUE THEN FAIL_FLAG = TRUE;

  IF FAIL_FLAG THEN
  DO;
    WRITE(6) 'GOTO TOKEN CHECK FAILED';
    ZERO = ZERO - 1;
    TRAP = 1 / ZERO;
  END;
  ELSE
    WRITE(6) 'GOTO TOKEN PASSED';

CLOSE GOTO_TOKEN;
