/* GLOBAL MEMORY BLOCK */
SHUTTLE_STATE: COMPOOL;
  DECLARE SYS_CLOCK SCALAR STATIC INITIAL(0.0);
  DECLARE VEHICLE_MASS SCALAR CONSTANT(105000.0);
  DECLARE GNC_ACTIVE BOOLEAN INITIAL(FALSE);
CLOSE SHUTTLE_STATE;

/* SEPARATE TASK ACCESSING GLOBAL MEMORY */
PROPAGATOR: TASK;
  DECLARE LOCAL_TIME SCALAR;

  /* COMPILER MUST RESOLVE THESE SYMBOLS TO THE COMPOOL */
  IF GNC_ACTIVE = TRUE THEN
  DO;
    LOCAL_TIME = SYS_CLOCK;
    SYS_CLOCK = SYS_CLOCK + 0.125;
  END;
CLOSE PROPAGATOR;
