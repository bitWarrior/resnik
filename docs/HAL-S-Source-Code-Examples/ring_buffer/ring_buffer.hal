RING_BUFFER: PROGRAM;
  DECLARE MAX_PKTS INTEGER CONSTANT(16);
  DECLARE TELEMETRY_RING ARRAY(16) OF INTEGER;
  DECLARE WRITE_IDX INTEGER INITIAL(1);
  DECLARE PACKET_COUNT INTEGER INITIAL(0);
  DECLARE INBOUND_DATA INTEGER;

  DECLARE WRAP BOOLEAN INITIAL(FALSE);

  /* SIMULATE RECEIVING 20 PACKETS TO FORCE A BUFFER WRAP */
  DO WHILE PACKET_COUNT < 20;

    /* INGEST SIMULATED jstar PACKET */
    INBOUND_DATA = PACKET_COUNT * 2;
    
    /* WRITE TO THE CURRENT RING BUFFER SLOT */
    TELEMETRY_RING$WRITE_IDX = INBOUND_DATA;

    /* CYCLIC INDEX INCREMENT USING MOD
       Because HAL/S uses 1-based indexing, the index must wrap 
       back to 1 rather than 0. 
    */
    WRITE_IDX = (WRITE_IDX MOD MAX_PKTS) + 1;

    PACKET_COUNT = PACKET_COUNT + 1;
  END;

  /* AFTER 20 INSERTS ON A 16-SLOT BUFFER, THE INDEX SHOULD BE AT 5 */
  IF WRITE_IDX = 5 THEN
  DO;
    WRAP = TRUE;
    WRITE(6) 'VERIFIES RING BUFFER WRAPPED SUCCESSFULLY';
  END;

CLOSE RING_BUFFER;
