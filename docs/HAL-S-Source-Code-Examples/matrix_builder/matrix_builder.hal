MATRIX_BUILDER: PROGRAM;
  /* DECLARE COMPONENT VECTORS */
  DECLARE ROW_1 VECTOR(3) INITIAL(1.0, 0.0, 0.0);
  DECLARE ROW_2 VECTOR(3) INITIAL(0.0, 1.0, 0.0);
  DECLARE ROW_3 VECTOR(3) INITIAL(0.0, 0.0, 1.0);
  
  DECLARE KILROY_DCM MATRIX(3,3);

  /* CONSTRUCTING A MATRIX FROM VECTOR ROWS */
  KILROY_DCM = MATRIX(ROW_1, ROW_2, ROW_3);

  /* VERIFY DIAGONAL TRACE IS 3.0 */
  IF TRACE(KILROY_DCM) = 3.0 THEN
  DO;
    WRITE(6) 'ROW-BASED CONSTRUCTION SUCCESSFUL';
  END;

CLOSE MATRIX_BUILDER;
