SENSOR_INIT: PROGRAM;
  DECLARE VEC_CALIB VECTOR(3);
  DECLARE IDX INTEGER;
  DECLARE FAIL_FLAG BOOLEAN INITIAL(FALSE);

  /* STANDARD FOR LOOP */
  DO FOR IDX = 1 TO 3;
    
    /* DYNAMIC SUBSCRIPTING USING $ */
    VEC_CALIB$IDX = 1.0;
    
    IF VEC_CALIB$IDX NOT = 1.0 THEN
    DO;
      FAIL_FLAG = TRUE;
    END;

  END;

  IF FAIL_FLAG = TRUE THEN
  DO;
    WRITE(6) 'CALIBRATION FAULT';
  END;

CLOSE SENSOR_INIT;
