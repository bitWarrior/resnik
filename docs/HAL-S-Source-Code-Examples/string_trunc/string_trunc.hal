STRING_TRUNC: PROGRAM;
  DECLARE SHORT_BUF CHARACTER(5);
  DECLARE LONG_BUF CHARACTER(15);
  DECLARE KILROY_MSG CHARACTER(20) INITIAL('KILROY WAS HERE');

  /* TRUNCATION: 20 CHARACTERS FORCED INTO 5 */
  /* Target holds: 'KILRO' */
  SHORT_BUF = KILROY_MSG; 

  /* PADDING: 5 CHARACTERS FORCED INTO 15 */
  /* Target holds: 'KILRO          ' (padded with 10 spaces) */
  LONG_BUF = SHORT_BUF; 

  IF SHORT_BUF = 'KILRO' THEN
  DO;
     WRITE(6) 'IMPLICIT TRUNCATION PASSED';
  END;
  
CLOSE STRING_TRUNC;
