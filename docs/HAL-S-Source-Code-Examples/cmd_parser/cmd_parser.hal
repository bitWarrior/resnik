CMD_PARSER: PROGRAM;
  DECLARE INBOUND_BUFFER CHARACTER(64) INITIAL('USER:jstar CMD:EXECUTE_MANEUVER;');
  DECLARE EXTRACTED_USER CHARACTER(5);
  DECLARE EXTRACTED_CMD CHARACTER(16);

  /* CHARACTER SLICING USING $ AND TO */
  EXTRACTED_USER = INBOUND_BUFFER$(6 TO 10);
  EXTRACTED_CMD = INBOUND_BUFFER$(16 TO 31);

  IF EXTRACTED_USER = 'jstar' THEN
  DO;
    WRITE(6) 'USER AUTHENTICATED, PARSING PAYLOAD';
  END;
  ELSE
  DO;
    WRITE(6) 'COMMAND INJECTION REJECTED';
  END;
CLOSE CMD_PARSER;
