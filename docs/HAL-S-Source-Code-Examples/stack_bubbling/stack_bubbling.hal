STACK_BUBBLING: PROGRAM;
  DECLARE DIVISOR INTEGER INITIAL(0);
  DECLARE FAULT_TRAP BOOLEAN INITIAL(FALSE);

  /* PROGRAM-LEVEL ERROR HANDLER (CATCHES UNHANDLED SUBROUTINE FAULTS) */
  ON ERROR(5):
  DO;
    WRITE(6) 'GLOBAL HANDLER CAUGHT DIVIDE-BY-ZERO';
    FAULT_TRAP = TRUE;
    RESUME;
  END;

  MATH_TASK: PROCEDURE(INPUT_VAL);
    DECLARE INPUT_VAL INTEGER;
    DECLARE LOCAL_RESULT SCALAR;
    
    /* NO LOCAL ERROR HANDLER EXISTS HERE */
    
    /* THIS TRIGGERS ERROR CODE 5 */
    LOCAL_RESULT = 100.0 / INPUT_VAL; 
    
    WRITE(6) 'THIS LINE SHOULD NEVER EXECUTE';
  CLOSE MATH_TASK;

  /* CALLING THE PROCEDURE THAT WILL FAULT */
  CALL MATH_TASK(DIVISOR);

  IF FAULT_TRAP THEN
  DO;
    WRITE(6) 'STACK UNWINDING AND BUBBLING SUCCESSFUL';
  END;

CLOSE STACK_BUBBLING;
