REPLACE_PARAMETRIC: PROGRAM;

  REPLACE SCALE(X) BY 2.0(X);
  REPLACE BETA(Y, ANGLE) BY Y + ANGLE;

  DECLARE N SCALAR INITIAL(3.0);
  DECLARE A INTEGER INITIAL(10);
  DECLARE B INTEGER INITIAL(7);
  DECLARE TWICE SCALAR;
  DECLARE SUM INTEGER;
  DECLARE ZERO INTEGER INITIAL(1);
  DECLARE TRAP INTEGER;
  DECLARE FAIL_FLAG BOOLEAN INITIAL(FALSE);

  /* SCALE(N + 1.0) -> 2.0(N + 1.0) -> 2.0 * (3.0 + 1.0) = 8.0 */
  TWICE = SCALE(N + 1.0);

  /* BETA(A, B) -> A + B = 17 */
  SUM = BETA(A, B);

  WRITE(6) 'REPLACE RESULTS:', TWICE, SUM;
  IF TWICE NOT = 8.0 THEN FAIL_FLAG = TRUE;
  IF SUM NOT = 17 THEN FAIL_FLAG = TRUE;

  IF FAIL_FLAG THEN
  DO;
    WRITE(6) 'PARAMETRIC REPLACE CHECK FAILED';
    ZERO = ZERO - 1;
    TRAP = 1 / ZERO;
  END;
  ELSE
    WRITE(6) 'PARAMETRIC REPLACE PASSED';

CLOSE REPLACE_PARAMETRIC;
