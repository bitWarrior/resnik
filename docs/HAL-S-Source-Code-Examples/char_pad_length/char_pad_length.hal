CHAR_PAD_LENGTH: PROGRAM;

  DECLARE PADDED CHARACTER(10) INITIAL('OK');
  DECLARE LEFT CHARACTER(4) INITIAL('ABCD');
  DECLARE RIGHT CHARACTER(2) INITIAL('EF');
  DECLARE COMBINED CHARACTER(6);
  DECLARE N INTEGER;
  DECLARE ZERO INTEGER INITIAL(1);
  DECLARE TRAP INTEGER;
  DECLARE FAIL_FLAG BOOLEAN INITIAL(FALSE);

  N = LENGTH(PADDED);
  WRITE(6) 'LENGTH OF PADDED INITIAL:', N;
  IF N NOT = 2 THEN FAIL_FLAG = TRUE;

  /* 'OK' is shorter than CHARACTER(10); compare must pad, not reject. */
  IF PADDED = 'OK' THEN
    WRITE(6) 'BLANK-EXTENDED COMPARE MATCHED';
  ELSE
    FAIL_FLAG = TRUE;

  COMBINED = LEFT || RIGHT;
  WRITE(6) 'EXACT-FIT CONCAT:', COMBINED;
  IF COMBINED NOT = 'ABCDEF' THEN FAIL_FLAG = TRUE;
  IF LENGTH(COMBINED) NOT = 6 THEN FAIL_FLAG = TRUE;

  IF FAIL_FLAG THEN
  DO;
    WRITE(6) 'CHAR PAD/LENGTH CHECK FAILED';
    ZERO = ZERO - 1;
    TRAP = 1 / ZERO;
  END;
  ELSE
    WRITE(6) 'CHAR PAD/LENGTH PASSED';

CLOSE CHAR_PAD_LENGTH;
