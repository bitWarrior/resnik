LEXER_EDGES: PROGRAM;

  DECLARE RATE INTEGER INITIAL(3);
  DECLARE SCALE INTEGER INITIAL(4);
  DECLARE GLUE_PROD INTEGER;
  DECLARE LIT_PROD INTEGER;

  DECLARE SUFFIX_BITS BIT(4) INITIAL('1010'B);
  DECLARE SUFFIX_HEX BIT(8) INITIAL('FF'H);
  DECLARE SUFFIX_OCT BIT(6) INITIAL('17'O);
  DECLARE PREFIX_OCT BIT(9) INITIAL(OCT '777');
  DECLARE MIXED_HEX BIT(8) INITIAL(hex 'AA');

  /* Exactly 32 characters -- one token, not a silent split. */
  DECLARE EXACTLYTHIRTYTWOCHARACTERNAMES32 INTEGER INITIAL(32);

  DECLARE ZERO INTEGER INITIAL(1);
  DECLARE TRAP INTEGER;
  DECLARE FAIL_FLAG BOOLEAN INITIAL(FALSE);

  /* Comment between two numeric operands is a multiply, not the token 34. */
  LIT_PROD = 3/*scale*/4;

  /* Comment between two identifiers is a multiply, not one glued name. */
  GLUE_PROD = RATE/*adj*/SCALE;

  WRITE(6) 'COMMENT GLUE PRODUCTS:', LIT_PROD, GLUE_PROD;
  IF LIT_PROD NOT = 12 THEN FAIL_FLAG = TRUE;
  IF GLUE_PROD NOT = 12 THEN FAIL_FLAG = TRUE;

  WRITE(6) 'SUFFIX BIT/HEX/OCT:', INTEGER(SUFFIX_BITS), INTEGER(SUFFIX_HEX), INTEGER(SUFFIX_OCT);
  IF INTEGER(SUFFIX_BITS) NOT = 10 THEN FAIL_FLAG = TRUE;
  IF INTEGER(SUFFIX_HEX) NOT = 255 THEN FAIL_FLAG = TRUE;
  IF INTEGER(SUFFIX_OCT) NOT = 15 THEN FAIL_FLAG = TRUE;

  WRITE(6) 'PREFIX OCT AND MIXED-CASE HEX:', INTEGER(PREFIX_OCT), INTEGER(MIXED_HEX);
  IF INTEGER(PREFIX_OCT) NOT = 511 THEN FAIL_FLAG = TRUE;
  IF INTEGER(MIXED_HEX) NOT = 170 THEN FAIL_FLAG = TRUE;

  WRITE(6) '32-CHAR IDENTIFIER VALUE:', EXACTLYTHIRTYTWOCHARACTERNAMES32;
  IF EXACTLYTHIRTYTWOCHARACTERNAMES32 NOT = 32 THEN FAIL_FLAG = TRUE;

  IF FAIL_FLAG THEN
  DO;
    WRITE(6) 'LEXER EDGES CHECK FAILED';
    ZERO = ZERO - 1;
    TRAP = 1 / ZERO;
  END;
  ELSE
    WRITE(6) 'LEXER EDGES PASSED';

CLOSE LEXER_EDGES;
