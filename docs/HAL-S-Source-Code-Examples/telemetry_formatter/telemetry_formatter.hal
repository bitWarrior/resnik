TELEMETRY_FORMATTER: PROGRAM;
  DECLARE BASE_MSG CHARACTER(10) INITIAL('STATUS: ');
  DECLARE SUBSYS CHARACTER(4) INITIAL('GN&C');
  DECLARE FULL_MSG CHARACTER(25);
  DECLARE MSG_LENGTH INTEGER;

  /* STRING CONCATENATION OPERATOR */
  FULL_MSG = BASE_MSG || SUBSYS || ' NOMINAL';

  /* BUILT-IN LENGTH CHECK (MACRO/INTRINSIC) */
  MSG_LENGTH = LENGTH(FULL_MSG);

  IF FULL_MSG = 'STATUS: GN&C NOMINAL' THEN
  DO;
    WRITE(6) FULL_MSG;
  END;

CLOSE TELEMETRY_FORMATTER;
