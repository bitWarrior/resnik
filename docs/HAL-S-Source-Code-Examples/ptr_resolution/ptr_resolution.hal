PTR_RESOLUTION: PROGRAM;
  DECLARE GYRO_X SCALAR INITIAL(15.5);
  DECLARE GYRO_Y SCALAR INITIAL(-4.2);
  
  /* DECLARE A POINTER TO A SCALAR */
  DECLARE ACTIVE_AXIS NAME SCALAR;

  /* BIND THE POINTER TO A SPECIFIC MEMORY ADDRESS */
  ASSIGN ACTIVE_AXIS TO GYRO_X;

  /* KILROY INTERVENTION: MUTATING THROUGH THE POINTER */
  ACTIVE_AXIS = ACTIVE_AXIS + 0.5;

  /* RE-BINDING THE POINTER DYNAMICALLY */
  ASSIGN ACTIVE_AXIS TO GYRO_Y;

  IF GYRO_X = 16.0 THEN
  DO;
    WRITE(6) 'POINTER DEREFERENCE AND MUTATION SUCCESSFUL';
  END;

CLOSE PTR_RESOLUTION;
