BIT_LAYOUT: PROGRAM;

  DECLARE WORD BIT INITIAL(HEX '80000000');
  DECLARE MSB BIT(1);

  DECLARE WIDE BIT(16) INITIAL(HEX 'ABCD');
  DECLARE NARROW BIT(8);

  DECLARE BYTE_VAL BIT(8) INITIAL(HEX '0F');
  DECLARE PROMOTED BIT(16);

  DECLARE FLAGS ARRAY(3) OF BIT(8);
  DECLARE BYTE_REG BIT(8);
  DECLARE I INTEGER INITIAL(2);
  DECLARE BIT2 BIT(1);

  DECLARE ZERO INTEGER INITIAL(1);
  DECLARE TRAP INTEGER;
  DECLARE FAIL_FLAG BOOLEAN INITIAL(FALSE);

  MSB = WORD$1;
  WRITE(6) 'UNSIZED BIT$1 (MSB):', INTEGER(MSB);
  IF INTEGER(MSB) NOT = 1 THEN FAIL_FLAG = TRUE;

  NARROW = WIDE;
  WRITE(6) 'BIT(16)->BIT(8) MSB FIELD:', INTEGER(NARROW);
  IF INTEGER(NARROW) NOT = 171 THEN FAIL_FLAG = TRUE;

  PROMOTED = BYTE_VAL;
  WRITE(6) 'BIT(8)->BIT(16) MSB JUSTIFY:', INTEGER(PROMOTED);
  IF INTEGER(PROMOTED) NOT = 3840 THEN FAIL_FLAG = TRUE;

  BYTE_REG = HEX '80';
  FLAGS$1 = BYTE_REG;
  BYTE_REG = HEX '40';
  FLAGS$2 = BYTE_REG;
  BYTE_REG = HEX '20';
  FLAGS$3 = BYTE_REG;

  /* FLAGS$2 = 01000000B; bit 2 (MSB-first) is 1. */
  BIT2 = FLAGS$I$2;
  WRITE(6) 'ARRAY OF BIT NESTED SUBSCRIPT:', INTEGER(BIT2);
  IF INTEGER(BIT2) NOT = 1 THEN FAIL_FLAG = TRUE;

  IF FAIL_FLAG THEN
  DO;
    WRITE(6) 'BIT LAYOUT CHECK FAILED';
    ZERO = ZERO - 1;
    TRAP = 1 / ZERO;
  END;
  ELSE
    WRITE(6) 'BIT LAYOUT PASSED';

CLOSE BIT_LAYOUT;
