JSTAR_TELEMETRY: PROGRAM;
  DECLARE SPW_PORT_DIV INTEGER INITIAL(0);
  DECLARE CALC_RESULT SCALAR;
  DECLARE FAULT_ACTIVE BOOLEAN INITIAL(FALSE);

  /* SYSTEM-LEVEL ERROR HANDLER FOR DIVIDE-BY-ZERO (E.G., ERROR CODE 5) */
  ON ERROR(5):
  DO;
    WRITE(6) 'JSTAR SIMULATOR MATH FAULT DETECTED';
    FAULT_ACTIVE = TRUE;
    
    /* RESUME DIRECTS CONTROL FLOW BACK TO THE STATEMENT AFTER THE FAULT */
    RESUME; 
  END;

  /* INTENTIONAL FAULT TO TRIGGER THE HANDLER */
  CALC_RESULT = 100.0 / SPW_PORT_DIV;

  IF FAULT_ACTIVE = TRUE THEN
  DO;
    WRITE(6) 'EXECUTING SAFEHOLD PROTOCOLS';
  END;

CLOSE JSTAR_TELEMETRY;