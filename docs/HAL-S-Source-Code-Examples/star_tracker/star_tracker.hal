STAR_TRACKER: PROGRAM;
  STRUCTURE STAR_DATA:
    DECLARE MAGNITUDE SCALAR;
    DECLARE COORDS VECTOR(3);
    DECLARE VALID BOOLEAN;
  CLOSE STAR_DATA;

  /* DECLARING AN ARRAY OF COMPOUND TYPES */
  DECLARE CONSTELLATION ARRAY(5) OF STAR_DATA STRUCTURE;
  DECLARE IDX INTEGER;
  DECLARE KILROY_FLAG BOOLEAN INITIAL(FALSE);

  /* ITERATING OVER THE STRUCT ARRAY */
  DO FOR IDX = 1 TO 5;
    /* CHAINING 1D SUBSCRIPTING ($) WITH TERMINAL ACCESS (.) */
    CONSTELLATION$IDX.MAGNITUDE = 0.0;
    CONSTELLATION$IDX.COORDS = VECTOR(0.0, 0.0, 0.0);
    CONSTELLATION$IDX.VALID = FALSE;
  END;

  WRITE(6) 'TRACKER ARRAY INITIALIZED';
CLOSE STAR_TRACKER;
