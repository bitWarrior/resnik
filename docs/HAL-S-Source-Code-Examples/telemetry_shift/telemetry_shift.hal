TELEMETRY_SHIFT: PROGRAM;
  DECLARE RAW_REG BIT(16) INITIAL(HEX 'F0A5');
  DECLARE MASK BIT(16) INITIAL(HEX '00FF');
  DECLARE SHIFTED_VAL BIT(16);
  DECLARE ALARM_FLAG BOOLEAN INITIAL(FALSE);

  /* LOGICAL SHIFT RIGHT BY 4 BITS */
  /* HAL/S Uses a negative integer to denote a right shift */
  SHIFTED_VAL = SHIFT(RAW_REG, -4);

  /* BITWISE 'AND' OPERATOR */
  SHIFTED_VAL = SHIFTED_VAL AND MASK;

  IF SHIFTED_VAL = HEX '000A' THEN
  DO;
    ALARM_FLAG = TRUE;
    WRITE(6) 'KILROY SPOTTED IN THE SHIFT REGISTER';
  END;
CLOSE TELEMETRY_SHIFT;
