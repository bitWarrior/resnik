ALDRIN_SYS_EXEC: PROGRAM;
  DECLARE FLIGHT_PHASE INTEGER INITIAL(1);

  /* Shared with the cyclic task so WAIT UNTIL can observe the stop request. */
  EXEC_STATE: COMPOOL;
    DECLARE RUN_FLAG BOOLEAN INITIAL(TRUE);
    DECLARE POLL_COUNT INTEGER INITIAL(0);
  CLOSE EXEC_STATE;

  POLL_SENSORS: TASK;
    DECLARE N INTEGER;
    WRITE(6) 'READING IMU AND STAR TRACKER';
    N = POLL_COUNT + 1;
    POLL_COUNT = N;
    /* Short acquisition burst, then release the executive to CANCEL. */
    IF N >= 3 THEN
      RUN_FLAG = FALSE;
  CLOSE POLL_SENSORS;

  /* SCHEDULE IMMEDIATELY, THEN CYCLICALLY */
  SCHEDULE POLL_SENSORS IN 0.5 REPEAT EVERY 0.125;

  /* BLOCK MAIN THREAD UNTIL CONDITION MET */
  WAIT UNTIL RUN_FLAG = FALSE;

  /* CANCEL THE CYCLIC TASK */
  CANCEL POLL_SENSORS;
  WRITE(6) 'SENSOR POLLING TERMINATED';

CLOSE ALDRIN_SYS_EXEC;
