SAT_MON: PROGRAM;

  /* MACRO SUBSTITUTION (PREPROCESSOR DIRECTIVES) */
  REPLACE SPW_ACTIVE BY '1'B;
  REPLACE SPW_OFFLINE BY '0'B;

  /* BIT STRING DECLARATIONS AND HEX LITERALS */
  DECLARE TELEMETRY_REG BIT(16) INITIAL(HEX '00FF');
  DECLARE SYS_STATUS BIT(16);
  DECLARE SPW_PORT_A BIT(1);
  DECLARE SPW_PORT_B BIT(1);

  /* BIT SLICING/EXTRACTION ($ DENOTES 1D SUBSCRIPTING) */
  SPW_PORT_A = TELEMETRY_REG$1;
  SPW_PORT_B = TELEMETRY_REG$2;

  /* BITWISE LOGICAL OPERATIONS AND CONDITIONALS */
  IF (SPW_PORT_A = SPW_ACTIVE) AND (SPW_PORT_B = SPW_OFFLINE) THEN
  DO;
    WRITE(6) 'PORT B OFFLINE, COMMENCING DIAGNOSTICS';
    
    /* BIT TOGGLING USING EXCLUSIVE OR (XOR) */
    SYS_STATUS = TELEMETRY_REG XOR HEX '0002';
  END;
  ELSE
  DO;
    SYS_STATUS = TELEMETRY_REG;
  END;

CLOSE SAT_MON;
