TENSOR_INIT: PROGRAM;
  /* 2D ARRAY HOLDING NATIVE 3D VECTORS */
  DECLARE TENSOR_GRID ARRAY(4, 4) OF VECTOR(3);
  DECLARE I INTEGER;
  DECLARE J INTEGER;

  /* NESTED LOOP INITIALIZATION */
  DO FOR I = 1 TO 4;
    DO FOR J = 1 TO 4;
      /* 2D SUBSCRIPTING $() ASSIGNED TO A GEOMETRIC TYPE */
      TENSOR_GRID$(I, J) = VECTOR(0.0, 0.0, 0.0);
    END;
  END;

  WRITE(6) 'GRID INITIALIZED ON TARGET';
CLOSE TENSOR_INIT;
