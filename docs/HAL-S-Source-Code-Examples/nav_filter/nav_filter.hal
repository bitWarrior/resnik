NAV_FILTER: PROGRAM;

  DECLARE ORBIT_DCM MATRIX(3,3);
  DECLARE X_AXIS VECTOR(3);
  DECLARE Y_AXIS VECTOR(3);
  DECLARE SUB_PANEL MATRIX(2,2);

  /* INITIALIZE A 3X3 MATRIX (ROW BY ROW) */
  ORBIT_DCM = MATRIX(1.0, 0.0, 0.0,
                     0.0, 0.8, 0.6,
                     0.0, -0.6, 0.8);

  /* COLUMN EXTRACTION: FIRST COLUMN IS THE BODY X AXIS */
  X_AXIS = ORBIT_DCM(*,1);

  /* COLUMN EXTRACTION: SECOND COLUMN IS THE BODY Y AXIS */
  Y_AXIS = ORBIT_DCM(*,2);

  /* SUB-MATRIX EXTRACTION: SLICING A 2X2 OUT OF A 3X3 */
  SUB_PANEL = ORBIT_DCM(2 TO 3, 2 TO 3);

  IF ABVAL(X_AXIS) = 1.0 THEN
  DO;
    WRITE(6) 'TRANSFORMATION MATRIX VALID';
  END;

CLOSE NAV_FILTER;
