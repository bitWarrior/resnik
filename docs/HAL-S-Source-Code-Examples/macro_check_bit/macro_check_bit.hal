MACRO_CHECK_BIT: PROGRAM;
  DECLARE RAW_REG BIT(16) INITIAL(HEX 'FFFF');
  DECLARE PARSED_FLAG BOOLEAN INITIAL(FALSE);

  /* DEFINE A MACRO WITH PARAMETERS */
  MACRO CHECK_BIT(REG_INPUT, BIT_POS, OUT_FLAG);
    IF REG_INPUT$BIT_POS = '1'B THEN
    DO;
      OUT_FLAG = TRUE;
    END;
    ELSE
    DO;
      OUT_FLAG = FALSE;
    END;
  MEND;

  /* MACRO EXPANSION/CALL */
  CHECK_BIT(RAW_REG, 4, PARSED_FLAG);

  IF PARSED_FLAG THEN
  DO;
    WRITE(6) 'MACRO EXPANSION RESOLVED SUCCESSFULLY';
  END;

CLOSE MACRO_CHECK_BIT;
