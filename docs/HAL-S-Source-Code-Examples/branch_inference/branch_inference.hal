BRANCH_INFERENCE: PROGRAM;
  DECLARE MODEL_STATE INTEGER INITIAL(2);
  DECLARE INFERENCE_CONF SCALAR INITIAL(0.0);
  DECLARE READY_FLAG BOOLEAN INITIAL(FALSE);

  /* THE INDEX OF 'MODEL_STATE' DETERMINES WHICH STATEMENT EXECUTES */
  DO CASE MODEL_STATE;
    /* CASE 1: INITIALIZING */
    INFERENCE_CONF = 0.0;
    
    /* CASE 2: WARM-UP / LOADING */
    INFERENCE_CONF = 0.45;
    
    /* CASE 3: ACTIVE INFERENCE */
    DO;
      INFERENCE_CONF = 0.92;
      READY_FLAG = TRUE;
    END;
  END;

  IF READY_FLAG = TRUE THEN
  DO;
    WRITE(6) 'SPACECRAFT NOMINAL, BEGINNING DOWNLINK';
  END;

CLOSE BRANCH_INFERENCE;
