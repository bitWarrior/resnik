FOR_SEMANTICS: PROGRAM;

  DECLARE P INTEGER;
  DECLARE Q INTEGER;
  DECLARE K INTEGER;
  DECLARE SUM INTEGER INITIAL(0);
  DECLARE I INTEGER;
  DECLARE J INTEGER;
  DECLARE ZERO INTEGER INITIAL(1);
  DECLARE TRAP INTEGER;
  DECLARE FAIL_FLAG BOOLEAN INITIAL(FALSE);

  DO FOR P = 1 TO 10;
    IF P = 4 THEN EXIT;
  END;
  WRITE(6) 'INDEX AFTER EXIT:', P;
  IF P NOT = 4 THEN FAIL_FLAG = TRUE;

  DO FOR Q = 1 TO 3;
  END;
  WRITE(6) 'INDEX AFTER COMPLETION:', Q;
  IF Q NOT = 4 THEN FAIL_FLAG = TRUE;

  DO FOR K = 1 TO 10 BY 3;
    SUM = SUM + K;
  END;
  WRITE(6) 'BY-STEP SUM AND INDEX:', SUM, K;
  IF SUM NOT = 22 THEN FAIL_FLAG = TRUE;
  IF K NOT = 13 THEN FAIL_FLAG = TRUE;

SEARCH:
  DO FOR I = 1 TO 5;
    DO FOR J = 1 TO 5;
      IF I = 2 THEN
      DO;
        IF J = 3 THEN
          EXIT SEARCH;
      END;
    END;
  END;

  WRITE(6) 'EXIT LABEL INDICES:', I, J;
  IF I NOT = 2 THEN FAIL_FLAG = TRUE;
  IF J NOT = 3 THEN FAIL_FLAG = TRUE;

  IF FAIL_FLAG THEN
  DO;
    WRITE(6) 'FOR SEMANTICS CHECK FAILED';
    ZERO = ZERO - 1;
    TRAP = 1 / ZERO;
  END;
  ELSE
    WRITE(6) 'FOR SEMANTICS PASSED';

CLOSE FOR_SEMANTICS;
