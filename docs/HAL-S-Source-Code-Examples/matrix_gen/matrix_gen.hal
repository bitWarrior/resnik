MATRIX_GEN: PROGRAM;
  DECLARE BASE_DCM MATRIX(3,3);
  DECLARE STATE_VEC VECTOR(6);
  DECLARE TRACE_RESULT SCALAR;

  /* CONTEXT-SENSITIVE IDENTITY GENERATION */
  BASE_DCM = IDENTITY;

  /* REPETITION LITERAL FORMAT: [COUNT]#[VALUE] */
  STATE_VEC = VECTOR(6#0.0);

  /* TRACE INTRINSIC (SUM OF THE DIAGONAL ELEMENTS) */
  TRACE_RESULT = TRACE(BASE_DCM);

  IF TRACE_RESULT = 3.0 THEN
  DO;
    WRITE(6) 'VERIFIED 3X3 IDENTITY MATRIX GENERATION';
  END;

CLOSE MATRIX_GEN;
