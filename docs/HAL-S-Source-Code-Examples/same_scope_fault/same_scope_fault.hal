SAME_SCOPE_FAULT: PROGRAM;
  DECLARE DIVISOR INTEGER INITIAL(0);
  DECLARE RESULT SCALAR;
  DECLARE FAULT_TRAP BOOLEAN INITIAL(FALSE);

  /* HANDLER IN THE SAME SCOPE AS THE FAULT */
  ON ERROR(5):
  DO;
    WRITE(6) 'SAME-SCOPE HANDLER CAUGHT DIVIDE-BY-ZERO';
    FAULT_TRAP = TRUE;
    RESUME;
  END;

  RESULT = 100.0 / DIVISOR;

  WRITE(6) 'AFTER FAULTING STATEMENT (RESUME CONTINUES HERE)';

  IF FAULT_TRAP THEN
  DO;
    WRITE(6) 'SAME-SCOPE HANDLING SUCCESSFUL';
  END;
CLOSE SAME_SCOPE_FAULT;
