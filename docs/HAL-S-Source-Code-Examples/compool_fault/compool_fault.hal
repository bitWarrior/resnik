FAULT_POOL: COMPOOL;
  DECLARE QUOTIENT SCALAR INITIAL(0.0);
  DECLARE CYCLE INTEGER INITIAL(0);
CLOSE FAULT_POOL;

COMPOOL_FAULT: PROGRAM;

  DECLARE ZERO INTEGER INITIAL(1);
  DECLARE TRAP INTEGER;
  DECLARE FAIL_FLAG BOOLEAN INITIAL(FALSE);

  ON ERROR(5):
  DO;
    WRITE(6) 'COMPOOL DIVIDE-BY-ZERO TRAPPED';
    RESUME;
  END;

  /* Sibling-COMPOOL store of a faulting divide. */
  QUOTIENT = 1.0 / 0.0;

  /* Read-modify-write of a COMPOOL INTEGER. */
  CYCLE = CYCLE + 1;

  WRITE(6) 'COMPOOL CYCLE AFTER RMW:', CYCLE;
  IF CYCLE NOT = 1 THEN FAIL_FLAG = TRUE;

  IF FAIL_FLAG THEN
  DO;
    WRITE(6) 'COMPOOL FAULT CHECK FAILED';
    ZERO = ZERO - 1;
    TRAP = 1 / ZERO;
  END;
  ELSE
    WRITE(6) 'COMPOOL FAULT PASSED';

CLOSE COMPOOL_FAULT;
