ABORT_MONITOR: PROGRAM;
  DECLARE I INTEGER;
  DECLARE J INTEGER;
  DECLARE SENSOR_READING SCALAR INITIAL(50.0);
  DECLARE ABORT_TRIGGERED BOOLEAN INITIAL(FALSE);

  DO FOR I = 1 TO 100;
    DO FOR J = 1 TO 100;
      
      IF SENSOR_READING > 99.0 THEN
      DO;
        ABORT_TRIGGERED = TRUE;
        /* EXPLICIT GOTO JUMPS OUT OF ALL NESTED LOOPS */
        GO TO ABORT_SEQUENCE;
      END;
      
      SENSOR_READING = SENSOR_READING + 0.01;
    END;
  END;

  WRITE(6) 'ALL SENSOR CHECKS PASSED';
  GO TO PROGRAM_END;

/* HAL/S LABEL DEFINITIONS */
ABORT_SEQUENCE:
  WRITE(6) 'ABORT SEQUENCE INITIATED BY KILROY TRIGGER';

PROGRAM_END:
  WRITE(6) 'EXECUTION COMPLETE';

CLOSE ABORT_MONITOR;
