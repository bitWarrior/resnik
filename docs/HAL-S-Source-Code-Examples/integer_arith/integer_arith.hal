INTEGER_ARITH: PROGRAM;

  DECLARE QUOT CONSTANT INTEGER(7 / 2);
  DECLARE N INTEGER INITIAL(2147483647);
  DECLARE NEG INTEGER INITIAL(7);
  DECLARE THREE INTEGER INITIAL(3);
  DECLARE TWO INTEGER INITIAL(2);
  DECLARE EIGHT INTEGER INITIAL(8);
  DECLARE R INTEGER;
  DECLARE POW INTEGER;
  DECLARE ROOT SCALAR;
  DECLARE ZERO INTEGER INITIAL(1);
  DECLARE TRAP INTEGER AUTOMATIC INITIAL(0);
  DECLARE FAIL_FLAG BOOLEAN INITIAL(FALSE);

  WRITE(6) 'FOLDED INTEGER QUOTIENT:', QUOT;
  IF QUOT NOT = 3 THEN FAIL_FLAG = TRUE;

  N = N + 1;
  WRITE(6) 'WRAPPED MAX+1 (expect negative):', N;
  IF N >= 0 THEN FAIL_FLAG = TRUE;

  R = (-NEG) MOD THREE;
  WRITE(6) 'EUCLIDEAN MOD:', R;
  IF R NOT = 2 THEN FAIL_FLAG = TRUE;

  POW = TWO ** EIGHT;
  WRITE(6) 'INTEGER POWER:', POW;
  IF POW NOT = 256 THEN FAIL_FLAG = TRUE;

  ROOT = 9.0 ** 0.5;
  WRITE(6) 'REAL EXPONENT SQRT:', ROOT;
  IF ROOT < 2.99 THEN FAIL_FLAG = TRUE;
  IF ROOT > 3.01 THEN FAIL_FLAG = TRUE;

  IF FAIL_FLAG THEN
  DO;
    WRITE(6) 'INTEGER ARITH CHECK FAILED';
    ZERO = ZERO - 1;
    TRAP = 1 / ZERO;
  END;
  ELSE
    WRITE(6) 'INTEGER ARITH PASSED';

CLOSE INTEGER_ARITH;
