COMPILE_TIME_MATH: PROGRAM;
  
  /* COMPILE-TIME SCALAR EVALUATIONS */
  DECLARE PI CONSTANT SCALAR(3.14159265);
  
  /* EXPRESSION USING EXISTING CONSTANTS */
  DECLARE HALF_PI CONSTANT SCALAR(PI / 2.0);
  
  /* KILROY CONSTANT USING INTRINSIC FUNCTION AT COMPILE TIME */
  DECLARE ANGLE CONSTANT SCALAR(ARCSIN(1.0));

  DECLARE RUNTIME_VAR SCALAR INITIAL(0.0);

  /* 
     THE COMPILER MUST REDUCE THIS ENTIRE EXPRESSION TO A LITERAL
     DURING THE AST OPTIMIZATION PASS, BEFORE CODE GENERATION.
  */
  RUNTIME_VAR = (HALF_PI * 2.0) - PI + ANGLE;

  IF RUNTIME_VAR = 1.57079632 THEN
  DO;
    WRITE(6) 'CONSTANT FOLDING ELIMINATED RUNTIME OVERHEAD';
  END;

CLOSE COMPILE_TIME_MATH;
