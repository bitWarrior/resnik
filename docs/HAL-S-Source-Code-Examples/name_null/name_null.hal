NAME_NULL: PROGRAM;

/* ****************************************************************
   NULL is a NAME value (null pointer), not a pointee.
   NAME(P) talks about the pointer cell; a bare P still dereferences.
**************************************************************** */

  DECLARE X SCALAR INITIAL(1.0);
  DECLARE P NAME SCALAR;
  DECLARE UNBOUND BOOLEAN INITIAL(FALSE);
  DECLARE BOUND BOOLEAN INITIAL(FALSE);
  DECLARE CLEARED BOOLEAN INITIAL(FALSE);
  DECLARE ZERO INTEGER INITIAL(1);
  DECLARE TRAP INTEGER;
  DECLARE FAIL_FLAG BOOLEAN INITIAL(FALSE);

  /* Unbound NAME starts null. */
  IF NAME(P) = NULL THEN
    UNBOUND = TRUE;
  IF NAME(P) = NAME(NULL) THEN
    UNBOUND = TRUE;
  WRITE(6) 'UNBOUND NAME IS NULL:', UNBOUND;
  IF UNBOUND NOT = TRUE THEN FAIL_FLAG = TRUE;

  ASSIGN P TO X;
  IF NAME(P) NOT = NULL THEN
    BOUND = TRUE;
  P = P + 1.0;
  WRITE(6) 'BOUND AND POINTEE:', BOUND, X;
  IF BOUND NOT = TRUE THEN FAIL_FLAG = TRUE;
  IF X NOT = 2.0 THEN FAIL_FLAG = TRUE;

  NAME(P) = NULL;
  IF NAME(P) = NULL THEN
    CLEARED = TRUE;
  ASSIGN P TO X;
  ASSIGN P TO NULL;
  IF NAME(P) NOT = NULL THEN
    CLEARED = FALSE;
  WRITE(6) 'CLEARED NAME IS NULL:', CLEARED;
  IF CLEARED NOT = TRUE THEN FAIL_FLAG = TRUE;

  IF FAIL_FLAG THEN
  DO;
    WRITE(6) 'NAME/NULL CHECK FAILED';
    ZERO = ZERO - 1;
    TRAP = 1 / ZERO;
  END;
  ELSE
    WRITE(6) 'NAME/NULL PASSED';

CLOSE NAME_NULL;
