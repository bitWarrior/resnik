TENSOR_MATH: PROGRAM;
  DECLARE BASE_WEIGHT SCALAR INITIAL(0.75);
  DECLARE BIAS SCALAR INITIAL(0.12);
  DECLARE INFERENCE_RESULT SCALAR;

  /* FUNCTION BLOCK WITH AN EXPLICIT RETURN TYPE */
  CALC_NODE: FUNCTION(WEIGHT, OFFSET) SCALAR;
    DECLARE WEIGHT SCALAR;
    DECLARE OFFSET SCALAR;
    DECLARE LOCAL_SUM SCALAR;

    LOCAL_SUM = (WEIGHT * 2.5) + OFFSET;
    
    /* EXPLICIT RETURN OF THE VALUE */
    RETURN LOCAL_SUM;
  CLOSE CALC_NODE;

  /* EMBEDDING THE FUNCTION CALL DIRECTLY IN AN EXPRESSION */
  INFERENCE_RESULT = CALC_NODE(BASE_WEIGHT, BIAS) * 100.0;

  IF INFERENCE_RESULT > 90.0 THEN
  DO;
    WRITE(6) 'EDGE DEEP LEARNING TARGET ACQUIRED IN jstar ENV';
  END;

CLOSE TENSOR_MATH;
