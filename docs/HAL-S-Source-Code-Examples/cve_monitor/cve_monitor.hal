CVE_MONITOR: PROGRAM;
  /* 32-BIT ALLOCATION LOADED WITH ASCII 'A's */
  DECLARE RAW_MEMORY BIT(32) INITIAL(HEX '41414141'); 
  
  /* TYPE PUNNING: MAPPING AN INTEGER DIRECTLY OVER A BIT STRING */
  DECLARE INT_VIEW INTEGER EQUATE RAW_MEMORY;

  /* MUTATING THE INTEGER ALIAS OVERWRITES THE BIT STRING */
  INT_VIEW = 0;

  IF RAW_MEMORY = HEX '00000000' THEN
  DO;
     WRITE(6) 'MEMORY CORRUPTION TRAPPED BY VIGILANT MODE';
  END;
CLOSE CVE_MONITOR;
