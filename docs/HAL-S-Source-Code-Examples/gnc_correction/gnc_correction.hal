GNC_CORRECTION: PROGRAM;

  /* DECLARE STATE VECTORS AND TRANSFORMATION MATRIX */
  DECLARE V_CURRENT VECTOR(3);
  DECLARE V_TARGET VECTOR(3);
  DECLARE V_ERR VECTOR(3);
  DECLARE M_DCM MATRIX(3,3); /* DIRECTION COSINE MATRIX */

  /* ... INITIALIZATION OF VECTORS OMITTED FOR BREVITY ... */

  /* NATIVE VECTOR MATH AND MATRIX MULTIPLICATION */
  V_ERR = V_TARGET - V_CURRENT;
  V_ERR = M_DCM * V_ERR;

  /* CONDITIONAL LOGIC USING BUILT-IN MAGNITUDE FUNCTION */
  IF ABVAL(V_ERR) > 0.1 THEN
  DO;
    SCHEDULE MANEUVER_TASK PRIORITY(15);
  END;
  ELSE
  DO;
    TERMINATE;
  END;

CLOSE GNC_CORRECTION;
