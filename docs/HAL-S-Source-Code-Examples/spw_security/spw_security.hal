SPW_SECURITY: PROGRAM;
  DECLARE SIG_VALID BOOLEAN INITIAL(FALSE);
  DECLARE OVERRIDE_KEY BIT(8) INITIAL(HEX 'AA');
  DECLARE ATTEMPTS INTEGER INITIAL(2);
  DECLARE LOCKDOWN BOOLEAN;

  /* NESTED LOGICAL AND RELATIONAL OPERATORS */
  IF (SIG_VALID = TRUE AND ATTEMPTS < 3) OR (OVERRIDE_KEY = HEX 'AA') THEN
  DO;
    WRITE(6) 'INTERFACE AUTHENTICATED';
    LOCKDOWN = FALSE;
  END;
  ELSE
  DO;
    WRITE(6) 'UNAUTHORIZED ACCESS TRAPPED';
    LOCKDOWN = TRUE;
  END;
  
  /* PRECEDENCE WITHOUT PARENTHESES */
  IF NOT LOCKDOWN AND ATTEMPTS > 0 THEN
  DO;
     WRITE(6) 'PROCEEDING WITH TELEMETRY DOWNLINK';
  END;

CLOSE SPW_SECURITY;
