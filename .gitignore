# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments (repo-local and common defaults)
resnik-venv/
.venv/
venv/
env/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# Test + coverage output
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/

# Type checkers + linters
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.dmypy.json

# Build backends
.hatch/

# Rust build artifacts (target/ appears under generated Cargo projects, e.g.
