target/
Cargo.lock

# Compiled objects / shared libs (i2c.o and friends land here)
*.o
*.so
*.dylib
*.dll
*.a

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject

# OS
.DS_Store
Thumbs.db

# Jupyter (if used for exploratory work)
.ipynb_checkpoints/

# Local secrets / environment overrides
.env
.env.local

# Backend package init (kept local; not part of the published tree)
src/resnik/backend/__init__.py

# IDE / driver package markers (kept local, same policy as the backend init)
ide/__init__.py
ide/resnik_ide/__init__.py
ide/resnik_ide/__main__.py
ide/tests/__init__.py
tests/test_driver/__init__.py

# Known stray artifacts at repo root
